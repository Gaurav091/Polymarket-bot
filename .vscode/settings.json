{
    "python.analysis.exclude": [
        "_reference/**",
        ".venv/**",
        "**/.env"
    ],
    "python.analysis.diagnosticMode": "openFilesOnly",
    "python.analysis.diagnosticSeverityOverrides": {
        "reportInsecureProtocol": "none",
        "reportFloatEquality": "none",
        "reportCognitiveComplexity": "none"
    },
    "sonarlint.analysisExcludes": "**/.env,**/.env.*",
    "sonarlint.rules": {
        "secrets:S6290": {
            "level": "off"
        }
    }
}
